skinparam sequenceParticipantBorderThickness 1.4
skinparam sequenceGroupBorderThickness 1.4
skinparam sequenceLifeLineBorderColor #A8A29E
skinparam sequenceLifeLineBackgroundColor #44403C
skinparam sequenceParticipantBorderColor #1C1917
skinparam sequenceParticipantBackgroundColor #FFFFFF
skinparam sequenceParticipantFontColor #1C1917
skinparam sequenceParticipantFontStyle bold
skinparam sequenceActorBorderColor #1C1917
skinparam sequenceActorBackgroundColor #F5F5F4
skinparam sequenceActorFontColor #1C1917
skinparam sequenceArrowColor #1C1917
skinparam sequenceArrowFontColor #1C1917
skinparam sequenceArrowFontSize 14
skinparam sequenceGroupBorderColor #1C1917
skinparam sequenceGroupBackgroundColor #FAFAF9
skinparam sequenceGroupHeaderFontColor #1C1917
skinparam sequenceGroupHeaderFontSize 14
skinparam sequenceGroupFontColor #1C1917
skinparam sequenceBoxBorderColor #1C1917
