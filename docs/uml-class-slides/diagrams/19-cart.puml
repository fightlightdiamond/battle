@startuml
!include style.iuml
left to right direction
class Customer
class ShoppingCart
class CartItem {
  -quantity: Integer
}
class Product {
  -productId: Integer
  -name: String
  -price: Decimal
}
Customer "1" *-- "1" ShoppingCart : owns
ShoppingCart "1" *-- "0..*" CartItem : contains
CartItem "0..*" --> "1" Product : refers to
@enduml
